__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Generated verification output (regenerate with tools/run_checks.py)
verification/_run/
# _capture.txt is regenerated by run_checks.py; kept for the HUG-G002 packet

# Ground segment environment - generated, never committed (DECISIONS.md D-007).
gnd/openc3/.env
gnd/openc3/openc3-redis/users.acl

# COSMOS local-mode write-back: installed plugin gems and instance state.
# Runtime state, not source. HUGINN's own plugin source lives at
# gnd/openc3/plugins/openc3-cosmos-huginn/ and IS committed.
gnd/openc3/plugins/DEFAULT/

# Built plugin gems. The gemspec is generated and committed; the gem it builds is
# a build artifact, rebuilt by tools/build_plugin.py from the same source.
gnd/openc3/plugins/openc3-cosmos-huginn/*.gem

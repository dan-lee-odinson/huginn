# HUGINN ground segment environment - TEMPLATE.
#
# This file is committed. The real .env is NOT: tools/setup_ground.py writes it from
# this template with freshly generated credentials, and .gitignore excludes it.
# Every __GENERATE__ below is filled in there.
#
# Credentials are generated rather than vendored for two reasons. Copying the training
# clone's values would make two instances share secrets, and committing any working
# credential to a repository that may become public is a footgun that outlives whatever
# posture made it seem safe. Upstream ships defaults here; this repository ships none.
#
# COMPOSE_PROJECT_NAME is what keeps HUGINN's containers, networks and named volumes in
# their own namespace, so campaign evidence never lands in the training demo's volumes
# and neither instance can disturb the other (DECISIONS.md D-007).
COMPOSE_PROJECT_NAME=huginn

# Which TAG to deploy, latest or specific version, e.g. 5.4.2
OPENC3_TAG=7.2.1
# Comment this variable to disable local mode (don't set it to 0)
OPENC3_LOCAL_MODE=1
# DO NOT SET THIS VARIABLE, IN ANY FORM. The demo plugin must not be installed in
# HUGINN's instance: HUG-GND-006 (B10) verifies the LOADED configuration against
# the dictionary of record, and a loaded INST/INST2 makes "the loaded
# configuration" something other than HUGINN's alone.
#
# init.sh line 179 reads `if [ ! -z $OPENC3_DEMO ]`, which tests the variable for
# PRESENCE, not for truth. Measured in the 7.2.1 image at both polarities:
#
#     OPENC3_DEMO=0        INSTALLS the demo
#     OPENC3_DEMO=false    INSTALLS the demo
#     OPENC3_DEMO=1        INSTALLS the demo
#     OPENC3_DEMO=         suppressed
#     (absent)             suppressed
#
# Every spelling of "off" a human would reach for turns it ON. This build shipped
# `OPENC3_DEMO=0` for one bring-up and the demo installed, which is what earned
# DECISIONS.md D-009. G16 fails on any assignment of a non-empty value, so
# restoring one cannot pass the gate quietly.
# OPENC3_DEMO=

# Set to the external domain name and port to access COSMOS.
# This is HUGINN's port (2910), NOT the training demo's 2900 that upstream ships
# here. Pointing this at 2900 sends HUGINN's own UI links to the other instance.
OPENC3_EXTERNAL_URL=http://localhost:2910
# Uncomment to force the init container to reinstall all plugins even if the same version exists.
# Use this to recover from a previously failed or interrupted init. Remove after successful init.
# OPENC3_FORCE_INSTALL=1
# Docker repo settings on where to get COSMOS containers
OPENC3_REGISTRY=docker.io
OPENC3_NAMESPACE=openc3inc
OPENC3_DEPENDENCY_REGISTRY=docker.io
OPENC3_ENTERPRISE_REGISTRY=ghcr.io
OPENC3_ENTERPRISE_NAMESPACE=openc3
OPENC3_UBI_REGISTRY=registry1.dso.mil
OPENC3_UBI_IMAGE=ironbank/redhat/ubi/ubi9-minimal
OPENC3_UBI_TAG=9.6
# Defined here as blank to avoid warnings. Used in the compose.yaml to pass '-ubi'.
OPENC3_IMAGE_SUFFIX=
# Bucket & Volume configuration
OPENC3_BUCKET_URL=http://openc3-buckets:9000
OPENC3_LOGS_BUCKET=logs
OPENC3_TOOLS_BUCKET=tools
OPENC3_CONFIG_BUCKET=config
OPENC3_GEMS_VOLUME=/gems
OPENC3_PLUGIN_DEFAULT_VOLUME=/plugins/DEFAULT
# Add additional buckets and volumes using the same convention:
# OPENC3_TEST_BUCKET=test_bucket
# This would add a new bucket called "test". Note the middle section OPENC3_(TEST)_BUCKET
# is the displayed name of the bucket and the value is the actual bucket name
# OPENC3_TEST_VOLUME=/path/to/somewhere
# This would add a new volume called "test". Note the middle section OPENC3_(TEST)_VOLUME
# is the displayed name of the volume and the value is the actual root path of the volume.

# Redis configuration
OPENC3_REDIS_HOSTNAME=openc3-redis
OPENC3_REDIS_PORT=6379
OPENC3_REDIS_EPHEMERAL_HOSTNAME=openc3-redis-ephemeral
OPENC3_REDIS_EPHEMERAL_PORT=6380
# Database configuration, see also TSDB in compose.yaml
OPENC3_TSDB_HOSTNAME=openc3-tsdb
OPENC3_TSDB_QUERY_PORT=8812
OPENC3_TSDB_INGEST_PORT=9000
OPENC3_TSDB_USERNAME=__GENERATE__
OPENC3_TSDB_PASSWORD=__GENERATE__
# Usernames and passwords
# These lines can be removed from this file if available in the host computer environment variables
OPENC3_REDIS_USERNAME=__GENERATE__
OPENC3_REDIS_PASSWORD=__GENERATE__
OPENC3_BUCKET_USERNAME=__GENERATE__
OPENC3_BUCKET_PASSWORD=__GENERATE__
OPENC3_SR_REDIS_USERNAME=__GENERATE__
OPENC3_SR_REDIS_PASSWORD=__GENERATE__
OPENC3_SR_BUCKET_USERNAME=__GENERATE__
OPENC3_SR_BUCKET_PASSWORD=__GENERATE__
# Redis ACL admin user. Upstream publishes a working hash for this; here it is
# generated, so nobody outside this machine holds it.
OPENC3_REDIS_ADMIN_PASSWORD=__GENERATE__
OPENC3_SERVICE_PASSWORD=__GENERATE__
# Rate limiting for authentication endpoints. Uncomment to change from defaults.
# In COSMOS Enterprise, use Keycloak to configure this instead.
# This prevents more than 10 failed password attempts within 120 seconds.
# OPENC3_AUTH_RATE_LIMIT_TO=10
# OPENC3_AUTH_RATE_LIMIT_WITHIN=120
# Build and repository settings
ALPINE_VERSION=3.23
ALPINE_BUILD=5
APK_URL=https://dl-cdn.alpinelinux.org
RUBYGEMS_URL=https://rubygems.org
PYPI_URL=https://pypi.org
NPM_URL=https://registry.npmjs.org
MAVEN_URL=https://repo.maven.apache.org/maven2
SECRET_KEY_BASE=__GENERATE__
OPENC3_CLOUD=local
# Change to arn:aws-us-gov for deploying to AWS Gov Cloud
OPENC3_AWS_ARN_PREFIX=arn:aws
# Update based on deployed region
AWS_REGION=us-east-1

# Uncomment to allow HTTP connections in the Content Security Policy (less secure)
# OPENC3_ALLOW_HTTP=1

# This can be used to set the default language for generators
# OPENC3_LANGUAGE=python

# Enable a default queue for ALL commands
# Commands can only opt out by specifying a specific queue with the 'queue' parameter
# OPENC3_DEFAULT_QUEUE=DEFAULT

# Don't automatically make the tools bucket public read
# OPENC3_NO_BUCKET_POLICY=1

# Log warnings and higher to stderr instead of stdout
# OPENC3_LOG_STDERR=1

# Prevent default tools from being installed by uncommenting the following environment variables:
# OPENC3_NO_CMDTLMSERVER=1
# OPENC3_NO_LIMITSMONITOR=1
# OPENC3_NO_CMDSENDER=1
# OPENC3_NO_SCRIPTRUNNER=1
# OPENC3_NO_PACKETVIEWER=1
# OPENC3_NO_TLMVIEWER=1
# OPENC3_NO_TLMGRAPHER=1
# OPENC3_NO_DATAEXTRACTOR=1
# OPENC3_NO_DATAVIEWER=1
# OPENC3_NO_HANDBOOKS=1
# OPENC3_NO_TABLEMANAGER=1
# OPENC3_NO_TOOLADMIN=1
# OPENC3_NO_BUCKETEXPLORER=1
# OPENC3_NO_DOCS=1

# Enables the --trusted-host flag when downloading python package from the PYPI_URL
# PIP_ENABLE_TRUSTED_HOST=1
